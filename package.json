{
  "name": "cuantovendi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "heroui-native": "^1.0.11",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "npx expo prebuild --clean --platform android && expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "android:release": "npx expo prebuild --clean --platform android && rm -rf android/app/build && expo run:android --variant release",
    "e2e:fixtures": "E2E_FIXTURES_WRITE=1 jest --selectProjects node --testPathPatterns e2e-fixtures",
    "e2e:build": "npm run e2e:fixtures && npx expo prebuild --clean --platform android && rm -rf android/app/build && EXPO_PUBLIC_E2E=1 expo run:android --variant release",
    "format:check": "prettier --check .",
    "test:watch": "jest --watch",
    "test:node": "jest --selectProjects node",
    "test:ui": "jest --selectProjects ui",
    "test:tz": "for zone in America/Santiago Pacific/Easter America/Punta_Arenas; do TEST_TZ=$zone jest --testPathPatterns \"(calendar|time-refresh|diagnostic-cases)\" || exit 1; done",
    "doctor": "npx expo-doctor && expo install --check",
    "e2e:android": "maestro test e2e/maestro",
    "db:generate": "drizzle-kit generate",
    "licenses:generate": "node tools/licenses/generate-licenses.js",
    "licenses:check": "node tools/licenses/generate-licenses.js --check",
    "publish:ios-go": "node tools/publish/publish-ios-go.js"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-updates",
          "expo-manifests",
          "expo-eas-client",
          "expo-structured-headers",
          "expo-updates-interface",
          "expo-json-utils"
        ]
      },
      "ios": {
        "exclude": [
          "expo-updates",
          "expo-manifests",
          "expo-eas-client",
          "expo-structured-headers",
          "expo-updates-interface",
          "expo-json-utils"
        ]
      }
    }
  }
}
